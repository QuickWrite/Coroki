package templates

import "github.com/QuickWrite/Coroki/internal/data"

templ LoginPage() {
    @Layout(PageMeta{
        Title: "Login | Coroki",
        Description: "Log in to your Coroki account",
        Robots: "noindex, nofollow",
        Scripts: []string{"app.js"},
        Stylesheets: []string{"app.css"},
    }) {
        <h1>Login</h1>
        <form method="post">
            <label for="name">Email:</label>
            <input type="email" id="email" name="email" placeholder="john-doe@example.com" />

            <label for="password">Password:</label>
            <input type="password" id="password" name="password" />

            <input type="submit" value="Submit" />
        </form>
    }
}

templ SignupPage() {
    @Layout(PageMeta{
        Title: "Signup | Coroki",
        Description: "Create your Coroki account",
        Robots: "noindex, nofollow",
        Scripts: []string{"app.js"},
        Stylesheets: []string{"app.css"},
    }) {
        <h1>Signup</h1>
        <form method="post">
            <label for="name">Username:</label>
            <input type="text" id="name" name="name" placeholder="John Doe" />

            <label for="name">Email:</label>
            <input type="email" id="email" name="email" placeholder="john-doe@example.com" />

            <label for="password">Password:</label>
            <input type="password" id="password" name="password" />

            <input type="submit" value="Submit" />
        </form>
    }
}

templ AuthTestLoggedIn(user *data.User) {
    @Layout(PageMeta{
        Title: "Test Session | Coroki",
        Description: "Testing the session",
        Robots: "noindex, nofollow",
        Scripts: []string{"app.js"},
        Stylesheets: []string{"app.css"},
    }) {
        <h1>Test session</h1>

        <p>You are logged in as <span>{ user.Name }</span>.</p>
        <ul>
            <li>Name: { user.Name }</li>
            <li>Email: { user.Email }</li>
        </ul>
    }
}

templ AuthTestNotLoggedIn() {
    @Layout(PageMeta{
        Title: "Test Session | Coroki",
        Description: "Testing the session",
        Robots: "noindex, nofollow",
        Scripts: []string{"app.js"},
        Stylesheets: []string{"app.css"},
    }) {
        <h1>Test session</h1>

        <p>You are <strong>not</strong> logged in.</p>
    }
}
